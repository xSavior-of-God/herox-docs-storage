{"time": 1735506000000, "blocks": [{"id": "0454ad6894", "type": "paragraph", "data": {"text": "&nbsp; <br>"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "c2eb38a1ce", "type": "header", "data": {"text": "<b>Simple Grave</b>", "level": 1}, "tunes": {"AlignmentTune": {"alignment": "center"}, "TextVariantTune": ""}}, {"id": "61adaa5898", "type": "codeBox", "data": {"code": "", "language": "yaml", "theme": "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "73c5981662", "type": "paragraph", "data": {"text": "The Simple Grave is the default tomb model. It uses block display entities with player head items to create a simple grave appearance.<br>"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "9d3b762760", "type": "paragraph", "data": {"text": "Each model has three configuration sections:"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "bbc9a4768b", "type": "paragraph", "data": {"text": "<b>Permission:</b> Permission required to use this model. Leave empty for no restriction.<br>"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "f4a6e0f8b4", "type": "paragraph", "data": {"text": "<b>Commands:</b> One or more summon commands using Minecraft's block/item display entities. The plugin automatically adjusts coordinates.<br>"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "8a673bfd8e", "type": "paragraph", "data": {"text": "<b>Item:</b> Configuration for the GUI selector item. Includes Type (usually PLAYER_HEAD), Name, Texture (base64 skull texture), and Lore.<br>"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}], "version": "2.30.6"}