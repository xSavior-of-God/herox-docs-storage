{"time": 1735506000000, "blocks": [{"id": "cff850f164", "type": "paragraph", "data": {"text": "&nbsp; <br>"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "e5a9d8684a", "type": "header", "data": {"text": "<b>ConfigurationWorlds</b>", "level": 1}, "tunes": {"AlignmentTune": {"alignment": "center"}, "TextVariantTune": ""}}, {"id": "99ff292e23", "type": "codeBox", "data": {"code": "", "language": "yaml", "theme": "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "889201a3dd", "type": "paragraph", "data": {"text": "The ConfigurationWorlds section defines groups of worlds and which grave models are available in each group. Each group has:"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "518fd46ddd", "type": "paragraph", "data": {"text": "<b>DefaultModel:</b> The model used when a player hasn't selected one.<br>"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "fbf9c52ec9", "type": "paragraph", "data": {"text": "<b>DisplayGroupName:</b> The name shown in the Model Selector GUI.<br>"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "6a1b6dfef4", "type": "paragraph", "data": {"text": "<b>Permission:</b> Required permission to view this group (empty = no permission needed).<br>"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "6266e0c466", "type": "paragraph", "data": {"text": "<b>Worlds:</b> List of worlds assigned to this group.<br>"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "c85a4a9cd6", "type": "paragraph", "data": {"text": "<b>Models:</b> List of available grave models for this group.<br>"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "102a31bba8", "type": "delimiter", "data": {"style": "line", "lineWidth": 50, "lineThickness": 2}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "632ff8b730", "type": "header", "data": {"text": "<b>Groups</b>", "level": 2}, "tunes": {"AlignmentTune": {"alignment": "center"}, "TextVariantTune": ""}}, {"id": "2b2b85e94f", "type": "paragraph", "data": {"text": "<b>World</b> - Default group for the overworld. Available models: SimpleGrave.<br>"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "1206e79a48", "type": "paragraph", "data": {"text": "<b>WorldNether</b> - Nether world group. Available models: SimpleGrave, GraveWithName, GraveWithZombie, GraveWithBats.<br>"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "b12b4282d3", "type": "paragraph", "data": {"text": "<b>WorldTheEnd</b> - End world group. Available models: SimpleGrave, GraveWithHead, GraveWithZombieAndHead.<br>"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "91618232c6", "type": "paragraph", "data": {"text": "<b>Full</b> - All worlds group with all models available if the player has the required permissions.<br>"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}], "version": "2.30.6"}