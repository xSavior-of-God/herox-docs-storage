{"time": 1735506000000, "blocks": [{"id": "ec6ef230f1", "type": "paragraph", "data": {"text": "&nbsp; <br>"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "490b2834e6", "type": "header", "data": {"text": "<b>Death Status</b>", "level": 1}, "tunes": {"AlignmentTune": {"alignment": "center"}, "TextVariantTune": ""}}, {"id": "0a3d72134f", "type": "codeBox", "data": {"code": "", "language": "yaml", "theme": "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "13207e3d57", "type": "paragraph", "data": {"text": "The DeathStatus determines how the plugin handles player deaths. There are three modes:"}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}, {"id": "8eb6d87471", "type": "nested_checklist", "data": {"style": "unordered", "items": [{"content": "<b>ACTIVE</b>: the plugin manages the death and spawns a player head as a tomb at the death location.", "items": []}, {"content": "<b>BROKEN</b>: the plugin registers all death information but does not spawn a tomb.", "items": []}, {"content": "<b>RECOVERABLE</b>: the plugin registers death info with the possibility to recover items via economy payment.", "items": []}]}, "tunes": {"AlignmentTune": {"alignment": "left"}, "TextVariantTune": ""}}], "version": "2.30.6"}